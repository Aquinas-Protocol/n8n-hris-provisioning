# Pin LF everywhere. The workflow JSON and the mock server are imported/run on a
# Linux CI runner and inside Linux containers; CRLF from the Windows author
# would leak into `n8n import:workflow` diffs and shell scripts.
* text=auto eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
