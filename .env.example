# Copy to .env. Every value here is a placeholder; CI runs with this file verbatim.
# Secrets that belong to SaaS accounts (Slack bot token, Notion secret) are NOT env vars —
# they go into n8n's credential store through the UI, under the exact names the workflow references.

# --- n8n ---------------------------------------------------------------------------
# Stable key so credentials stored by n8n survive container restarts. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32
# Base for the Approve/Decline links in Slack. Whoever clicks must be able to open it
# (localhost = click from the machine running n8n; a tailnet hostname works too).
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago
# REQUIRED for the native run: the workflow reads the ids below via $env.* (compose sets this too).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Google Admin SDK (mocked) ------------------------------------------------------
# Native run: the mock listens on localhost. Compose overrides this to http://mock-google-admin:8000.
# Real tenant: https://admin.googleapis.com + a Google OAuth2 credential on the two HTTP Request nodes.
GOOGLE_ADMIN_BASE_URL=http://localhost:8000
# Work email = first.last@DEMO_DOMAIN
DEMO_DOMAIN=example.test
# department-key=group, ... ; "default" is the fallback. Keys are lower-case, non-alphanumerics -> "-".
GOOGLE_GROUP_MAP=engineering=eng-team@example.test,default=all-hands@example.test

# --- Slack (channel ids only; the bot token lives in the n8n credential "Slack Bot (n8n-hris)") ---
SLACK_APPROVALS_CHANNEL_ID=C0000000000
SLACK_ALERTS_CHANNEL_ID=C0000000000
# department-key=channel-id, ... ; "default" is the fallback.
SLACK_ONBOARDING_CHANNEL_MAP=default=C0000000000

# --- Notion (the integration secret lives in the n8n credential "Notion (n8n-hris)") ---
# DATA SOURCE id (Notion API 2025-09+), NOT the 32-hex database id from the URL. See docs/notion-people-schema.md.
NOTION_DATA_SOURCE_ID=00000000-0000-0000-0000-000000000000

# --- HRIS webhook ingress ---------------------------------------------------------------
# Shared header token. Must equal the value of the n8n Header Auth credential "HRIS Webhook Token"
# (header name X-HRIS-Token). Only scripts/fire-webhook.* read it from here.
HRIS_WEBHOOK_TOKEN=replace-me
