    {
      "id": "9b2d5093-70c8-5778-9037-8da6e3a441d8",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One HRIS event per call. Any throw here routes to the Error Workflow (-> #it-alerts).\nconst body = $input.first().json.body ?? {};\nif (body.event !== 'employee.hired') throw new Error(`Unsupported event \"${body.event}\" (expected employee.hired)`);\nconst e = body.employee ?? {};\nconst req = (k) => { const v = String(e[k] ?? '').trim(); if (!v) throw new Error(`HRIS payload missing employee.${k}`); return v; };\nconst first = req('first_name'), last = req('last_name'), department = req('department'), startDate = req('start_date');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(startDate) || Number.isNaN(Date.parse(startDate))) throw new Error(`employee.start_date must be YYYY-MM-DD, got \"${startDate}\"`);\nif (Date.parse(startDate) < Date.now() - 30 * 86400e3) throw new Error(`employee.start_date ${startDate} is more than 30 days in the past`);\n\n// Work email = first.last@DEMO_DOMAIN, ASCII-folded and slugged (Zoë O'Brien -> zoe.obrien).\nconst slug = (s) => s.normalize('NFKD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '').slice(0, 30);\nconst domain = $env.DEMO_DOMAIN || 'example.test';\nconst workEmail = `${slug(first)}.${slug(last)}@${domain}`;\n\n// Department -> Google group / Slack onboarding channel, from env maps like \"engineering=eng@x,default=all@x\".\nconst parseMap = (s) => Object.fromEntries(String(s || '').split(',').map(p => p.trim()).filter(Boolean)\n  .map(p => { const [k, v] = p.split('='); return [k.trim().toLowerCase(), (v || '').trim()]; }));\nconst deptKey = department.toLowerCase().replace(/[^a-z0-9]+/g, '-');\nconst groups = parseMap($env.GOOGLE_GROUP_MAP), channels = parseMap($env.SLACK_ONBOARDING_CHANNEL_MAP);\nconst googleGroup = groups[deptKey] ?? groups.default ?? `all-hands@${domain}`;\nconst slackChannelId = channels[deptKey] ?? channels.default;\nif (!slackChannelId) throw new Error('SLACK_ONBOARDING_CHANNEL_MAP needs a default=C... entry');\n\n// Demo-only temporary password. Production: deliver out-of-band and disable success-data retention.\nconst alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%';\nconst tempPassword = Array.from({ length: 20 }, () => alphabet[Math.floor(Math.random() * alphabet.length)]).join('');\n\nreturn [{ json: {\n  event_id: body.event_id ?? null, employee_id: e.id ?? null,\n  first_name: first, last_name: last, full_name: `${first} ${last}`,\n  title: e.title ?? '', department, department_key: deptKey,\n  manager_email: e.manager_email ?? '', start_date: startDate, location: e.location ?? '',\n  work_email: workEmail, slack_lookup_email: String(e.existing_email || workEmail).toLowerCase(),\n  google_group: googleGroup, slack_channel_id: slackChannelId,\n  temp_password: tempPassword, received_at: new Date().toISOString(),\n}}];\n"
      }
    },
