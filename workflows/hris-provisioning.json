        "message": "=:bust_in_silhouette: *New-hire provisioning request*\n*Name:* {{ $('Normalize').first().json.full_name }} · *Title:* {{ $('Normalize').first().json.title }}\n*Department:* {{ $('Normalize').first().json.department }} · *Start:* {{ $('Normalize').first().json.start_date }} · *Manager:* {{ $('Normalize').first().json.manager_email }}\n*Work email:* `{{ $('Normalize').first().json.work_email }}`\n*Plan:* Google account → {{ $json.statusCode === 200 ? 'already exists (skip create)' : 'create' }} · group `{{ $('Normalize').first().json.google_group }}` · Slack <#{{ $('Normalize').first().json.slack_channel_id }}> · Notion People row\n_HRIS event_ `{{ $('Normalize').first().json.event_id }}` · _execution_ `{{ $execution.id }}` · auto-declines in 1h",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "buttonApprovalStyle": "primary",
            "disapproveLabel": "Decline",
            "buttonDisapprovalStyle": "secondary"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 1,
              "resumeUnit": "hours"
            }
          }
        }
      },
      "credentials": {
        "slackApi": {
          "id": null,
          "name": "Slack Bot (n8n-hris)"
        }
